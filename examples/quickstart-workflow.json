    {
      "parameters": {
        "content": "## Setup\n1. Select your Apify API credential.\n2. Replace the keyword and location.\n3. Run once, then add a Schedule Trigger for monitoring.\n4. Send the final company signals to your CRM or alert channel.",
        "height": 300,
        "width": 460
      },
      "id": "a80efc98-65d6-5b3d-b85e-ca4ea08d7276",
      "name": "How to use this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -240
      ]
    },
    {
      "parameters": {
        "keywords": "software engineer",
        "location": "United States",
        "maxPages": 1,
        "postedWithin": "any",
        "deduplicateCompanies": true,
        "minRecruiterScore": 0,
        "exportFormat": "default",
        "deepFetchAll": false
      },
      "id": "f9e0b493-5443-57c5-b1fc-83501cf41b89",
      "name": "Find current LinkedIn jobs",
      "type": "n8n-nodes-apivault-linkedin-jobs.linkedinJobs",
      "typeVersion": 1,
      "position": [
        260,
        120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json; return { json: { ...j, hiringSignal: { company: j.company ?? j.companyName ?? '', role: j.title ?? j.jobTitle ?? '', location: j.location ?? '', score: Number(j.recruiterScore ?? j.leadScore ?? 0), sourceUrl: j.jobUrl ?? j.url ?? '', observedAt: new Date().toISOString() } } };"
      },
